<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TeamsCaptionsSaver</AssemblyName>
    <RootNamespace>TeamsCaptionsSaver.Desktop</RootNamespace>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>Teams Captions Saver (Desktop)</Product>
  </PropertyGroup>

  <ItemGroup>
    <!-- Audio recording: WASAPI capture (NAudio) and the Opus encoder + Ogg writer (Concentus), all MIT. -->
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="Concentus" Version="2.2.2" />
    <PackageReference Include="Concentus.OggFile" Version="1.0.6" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TeamsCaptionsSaver.Tests" />
    <Resource Include="icon.ico" />
  </ItemGroup>

</Project>

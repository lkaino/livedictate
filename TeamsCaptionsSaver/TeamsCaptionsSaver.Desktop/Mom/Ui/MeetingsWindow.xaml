<Window x:Class="TeamsCaptionsSaver.Desktop.Mom.Ui.MeetingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Meetings" Height="560" Width="900" MinHeight="300" MinWidth="560"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="12">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Refresh" Click="OnRefreshClick" />
                <Button Content="Projects and AI agents…" Click="OnProjectsClick" Margin="0" />
            </StackPanel>
            <TextBox x:Name="SearchBox" Width="260" HorizontalAlignment="Left" Padding="4" TextChanged="OnSearchChanged"
                     ToolTip="Search by meeting name, date or speaker" />
        </DockPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Minutes (MoM)…" FontWeight="SemiBold" Click="OnMinutesClick" />
                <Button Content="Open folder" Click="OnOpenFolderClick" Margin="0" />
            </StackPanel>
            <TextBlock x:Name="CountText" VerticalAlignment="Center" Foreground="#666" />
        </DockPanel>
        <DataGrid x:Name="MeetingGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  HeadersVisibility="Column" GridLinesVisibility="None" MouseDoubleClick="OnGridDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Date" Binding="{Binding DateDisplay}" Width="120" />
                <DataGridTextColumn Header="Time" Binding="{Binding TimeDisplay}" Width="95" />
                <DataGridTextColumn Header="Meeting" Binding="{Binding Title}" Width="2*" />
                <DataGridTextColumn Header="Speakers" Binding="{Binding SpeakersDisplay}" Width="3*" />
                <DataGridTextColumn Header="Minutes" Binding="{Binding MomDisplay}" Width="70" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>

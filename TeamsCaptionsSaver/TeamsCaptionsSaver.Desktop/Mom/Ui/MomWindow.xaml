<Window x:Class="TeamsCaptionsSaver.Desktop.Mom.Ui.MomWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Minutes" Height="720" Width="1100" MinHeight="480" MinWidth="760"
        WindowStartupLocation="CenterOwner" Closing="OnClosing">
    <DockPanel Margin="12">
        <!-- Meeting and project -->
        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="MeetingTitle" FontSize="16" FontWeight="SemiBold" />
            <TextBlock x:Name="MeetingInfo" Foreground="#555" Margin="0,2,0,8" />
            <WrapPanel Margin="0,0,0,8">
                <TextBlock Text="Project:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox x:Name="ProjectBox" Width="240" Margin="0,0,6,0" SelectionChanged="OnProjectChanged" />
                <Button Content="Projects and AI agents…" Click="OnProjectsClick" />
                <Button x:Name="CreateButton" Content="Create minutes" FontWeight="SemiBold" Click="OnCreateClick" />
                <Button Content="Project memory" Click="OnMemoryClick"
                        ToolTip="Open the folder with the project's people, glossary and lessons" />
            </WrapPanel>
        </StackPanel>

        <!-- Speakers Teams didn't know -->
        <Border x:Name="SpeakersPanel" DockPanel.Dock="Top" Visibility="Collapsed" Background="#FFF7E6"
                BorderBrush="#F5C26B" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="Who is who? Teams didn't know these speakers' names. Leave a name empty if you don't know."
                           TextWrapping="Wrap" Margin="0,0,0,6" />
                <ItemsControl x:Name="SpeakerList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="{Binding Name}" Width="160" VerticalAlignment="Center" />
                                <ComboBox Width="260" IsEditable="True" ItemsSource="{Binding Suggestions}"
                                          Text="{Binding Answer, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Status and agent output -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="Stop" Visibility="Collapsed" Click="OnCancelClick" Margin="0" />
            <Expander x:Name="LogExpander" Header="Agent output">
                <TextBox x:Name="LogBox" Height="140" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="0,4,0,0" />
            </Expander>
        </DockPanel>
        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="0,8,0,0" Foreground="#555" TextWrapping="Wrap" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <!-- The minutes -->
            <DockPanel Margin="0,0,12,0">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Open in editor" Click="OnOpenInEditorClick" />
                        <Button Content="Open folder" Click="OnOpenFolderClick" />
                        <Button x:Name="FinalButton" Content="Mark as final" Click="OnFinalClick" Margin="0"
                                ToolTip="These minutes are right: keep them as the project's example of good minutes." />
                    </StackPanel>
                    <TextBlock Text="Version:" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox x:Name="VersionBox" Width="140" HorizontalAlignment="Left" SelectionChanged="OnVersionChanged" />
                </DockPanel>
                <TextBox x:Name="MomText" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas" Padding="6" />
            </DockPanel>

            <!-- Feedback and what to remember -->
            <DockPanel Grid.Column="1">
                <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,4"
                           Text="What's wrong? Write it in your own words, for example: Speaker 2 was Liisa. 'café' is Kafka. The budget decision is missing." />
                <Border x:Name="ProposalsPanel" DockPanel.Dock="Bottom" Visibility="Collapsed" BorderBrush="#CBD5E1"
                        BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="Remember for future meetings?" FontWeight="SemiBold" />
                        <TextBlock Text="Ticked points are saved to the project memory. Speaker and term fixes also correct this meeting's transcript."
                                   TextWrapping="Wrap" Foreground="#555" Margin="0,2,0,6" />
                        <ItemsControl x:Name="ProposalList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected}" Margin="0,2">
                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="Remember ticked" Click="OnRememberClick" />
                            <Button Content="Dismiss" Click="OnDismissClick" Margin="0" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Button x:Name="ReviseButton" DockPanel.Dock="Bottom" Content="Revise minutes" FontWeight="SemiBold"
                        HorizontalAlignment="Left" Margin="0,8,0,0" Click="OnReviseClick" />
                <TextBox x:Name="FeedbackBox" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" Padding="4" />
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
